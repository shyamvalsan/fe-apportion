#[test]
fn oracle_tiny_dominant_weight() {
    verify(
        1,
        [340282366920938463463374607431768211455, 1, 1],
        [1, 1, 1],
        1,
        [1, 0, 0],
    )
}

#[test]
fn oracle_cap_redistributes() {
    verify(100, [8, 1, 1], [40, 100, 100], 0, [40, 30, 30])
}

#[test]
fn oracle_successive_caps() {
    verify(100, [90, 9, 1], [20, 30, 100], 0, [20, 30, 50])
}

#[test]
fn oracle_binding_exact_cap() {
    verify(12, [1, 2, 3], [2, 4, 6], 0, [2, 4, 6])
}

#[test]
fn oracle_zero_caps() {
    verify(3, [9, 9, 1, 1], [0, 0, 10, 10], 3, [0, 0, 1, 2])
}

#[test]
fn oracle_just_below_rational_cap() {
    verify(10, [5, 3, 2], [4, 100, 100], 0, [4, 4, 2])
}

#[test]
fn oracle_rounding_reaches_cap() {
    verify(2, [1, 1, 1], [1, 1, 1], 0, [1, 1, 0])
}

#[test]
fn oracle_all_capacity_exact() {
    verify(
        340282366920938463463374607431768211455,
        [340282366920938463463374607431768211455, 1],
        [340282366920938463463374607431768211454, 1],
        0,
        [340282366920938463463374607431768211454, 1],
    )
}

#[test]
fn oracle_alabama_ten() {
    verify(10, [6, 6, 2], [10, 10, 10], 0, [4, 4, 2])
}

#[test]
fn oracle_alabama_eleven() {
    verify(11, [6, 6, 2], [11, 11, 11], 0, [5, 5, 1])
}

